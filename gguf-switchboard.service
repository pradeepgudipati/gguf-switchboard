# Reference unit matching deploy.sh. Live install writes the same content to
# /etc/systemd/system/gguf-switchboard.service.

[Unit]
Description=GGUF Switchboard - GPU-aware local GGUF model scheduler
After=network.target
Documentation=https://github.com/pradeepgudipati/gguf-switchboard

[Service]
Type=simple
User=ggs
Group=ggs
WorkingDirectory=/opt/gguf-switchboard
Environment=RUST_LOG=info
Environment=MODELS_DIR=/var/lib/gguf-switchboard/models
ExecStart=/usr/local/bin/gguf-switchboard /opt/gguf-switchboard/config.toml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
